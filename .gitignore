# Dependencies and generated application bundles
**/node_modules/
/app-alpha/dist/
/app-beta/dist/
/host/dist/
/host-v2/dist/

# Local services, temporary files, private configuration
/run/
/work/
/nginx/html/
/nginx/html-v2/
/nginx/logs/
/nginx/temp/
.env
.env.*
*.pem
*.key
.DS_Store

# Deprecated implementation and historical test runs
/docs/history/
/extension/src/DEPRECATED-*
/tests/*.js
/tests/package*.json
/tests/specs/
/tests/test-results/
/tests/playwright-report/

# Publish only the reviewed current acceptance materials
/evidence/*
!/evidence/v2/
!/evidence/host-v2-bundle-checksums.txt
/evidence/v2/final-state.json
